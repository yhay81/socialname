{
  "$defs": {
    "ContributionNetworkClass": {
      "description": "The client-declared coarse network class of the contributing vantage.\n\nThe claim provides diversity context and is recorded as claimed; it is not\ntreated as verified infrastructure truth.",
      "enum": [
        "datacenter",
        "residential",
        "anonymizer",
        "unknown"
      ],
      "type": "string"
    },
    "DefinitiveVerdict": {
      "enum": [
        "found",
        "not_found"
      ],
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "e0_no_account_evidence",
        "e1_weak_signal",
        "e2_differential_template",
        "e3_explicit_endpoint",
        "e4_structured_identity"
      ],
      "type": "string"
    },
    "EvidenceMatcherTrace": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "matched": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "matched",
        "detail"
      ],
      "type": "object"
    },
    "EvidenceOutcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "definitive",
              "type": "string"
            },
            "verdict": {
              "$ref": "#/$defs/DefinitiveVerdict"
            }
          },
          "required": [
            "kind",
            "verdict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uncertain",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UncertaintyReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "EvidenceProbe": {
      "additionalProperties": false,
      "properties": {
        "body_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "body_truncated": {
          "type": "boolean"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency_bucket_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "probe_id": {
          "type": "string"
        },
        "status": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "transport": {
          "$ref": "#/$defs/EvidenceTransportOutcome"
        }
      },
      "required": [
        "probe_id",
        "transport",
        "body_bytes",
        "body_truncated",
        "latency_bucket_ms"
      ],
      "type": "object"
    },
    "EvidenceTransportOutcome": {
      "enum": [
        "completed",
        "blocked",
        "rate_limited",
        "timeout",
        "dns",
        "connect",
        "tls",
        "redirect_rejected",
        "response_too_large",
        "decode"
      ],
      "type": "string"
    },
    "ProtocolVersion": {
      "enum": [
        "socialname.dev/api/v1"
      ],
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "site_id"
      ],
      "type": "object"
    },
    "UncertaintyReason": {
      "enum": [
        "site_changed",
        "no_rule_matched",
        "conflicting_evidence",
        "classification_ambiguous"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consent_grant_id": {
      "type": "string"
    },
    "engine_hash": {
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "evidence_digest": {
      "type": "string"
    },
    "installation_id": {
      "type": "string"
    },
    "matcher_trace": {
      "items": {
        "$ref": "#/$defs/EvidenceMatcherTrace"
      },
      "type": "array"
    },
    "network_class": {
      "$ref": "#/$defs/ContributionNetworkClass"
    },
    "observed_at_unix_ms": {
      "format": "int64",
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/EvidenceOutcome"
    },
    "probes": {
      "items": {
        "$ref": "#/$defs/EvidenceProbe"
      },
      "type": "array"
    },
    "region_class": {
      "type": "string"
    },
    "rule_hash": {
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/ProtocolVersion"
    },
    "sequence_number": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "required": [
    "schema",
    "installation_id",
    "consent_grant_id",
    "sequence_number",
    "target",
    "rule_hash",
    "engine_hash",
    "observed_at_unix_ms",
    "region_class",
    "network_class",
    "outcome",
    "evidence_class",
    "evidence_digest",
    "probes",
    "matcher_trace"
  ],
  "title": "SharedContributionSubmitRequest",
  "type": "object"
}
