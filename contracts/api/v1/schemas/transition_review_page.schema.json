{
  "$defs": {
    "AccountState": {
      "enum": [
        "found",
        "not_found"
      ],
      "type": "string"
    },
    "ConfirmationBasis": {
      "enum": [
        "managed_e4",
        "managed_e3_follow_up",
        "two_managed_independent_regions",
        "two_managed_separated_in_time",
        "corroborated_shared_candidate_opt_in",
        "measurement_health_evidence"
      ],
      "type": "string"
    },
    "MeasurementState": {
      "enum": [
        "healthy",
        "degraded",
        "quarantined",
        "recovering",
        "unavailable"
      ],
      "type": "string"
    },
    "PendingConfirmationReason": {
      "enum": [
        "managed_verification_required",
        "second_managed_observation_required",
        "regional_conflict"
      ],
      "type": "string"
    },
    "ProtocolVersion": {
      "enum": [
        "socialname.dev/api/v1"
      ],
      "type": "string"
    },
    "SuppressionReason": {
      "enum": [
        "shared_only_absence",
        "conflicting_evidence",
        "watch_paused",
        "supporting_evidence_deleted"
      ],
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "site_id"
      ],
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/TransitionChange"
        },
        "confirmation": {
          "$ref": "#/$defs/TransitionConfirmation"
        },
        "detected_at_unix_ms": {
          "format": "int64",
          "type": "integer"
        },
        "schema": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "supporting_observation_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "transition_id": {
          "type": "string"
        },
        "watch_id": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "transition_id",
        "watch_id",
        "target",
        "change",
        "confirmation",
        "supporting_observation_ids",
        "detected_at_unix_ms"
      ],
      "type": "object"
    },
    "TransitionChange": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "class": {
              "const": "account_state",
              "type": "string"
            },
            "from": {
              "$ref": "#/$defs/AccountState"
            },
            "to": {
              "$ref": "#/$defs/AccountState"
            }
          },
          "required": [
            "class",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "class": {
              "const": "measurement_health",
              "type": "string"
            },
            "from": {
              "$ref": "#/$defs/MeasurementState"
            },
            "region_class": {
              "type": "string"
            },
            "rule_hash": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/MeasurementState"
            }
          },
          "required": [
            "class",
            "region_class",
            "rule_hash",
            "from",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "TransitionConfirmation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/PendingConfirmationReason"
            },
            "status": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "basis": {
              "$ref": "#/$defs/ConfirmationBasis"
            },
            "status": {
              "const": "confirmed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "basis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/SuppressionReason"
            },
            "status": {
              "const": "suppressed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "TransitionReviewResolution": {
      "enum": [
        "action_taken",
        "no_action_required",
        "measurement_follow_up",
        "externally_escalated"
      ],
      "type": "string"
    },
    "TransitionReviewResource": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_at_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "acknowledged_by_membership_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "assigned_membership_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_unix_ms": {
          "format": "int64",
          "type": "integer"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionReviewResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_at_unix_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "resolved_by_membership_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_id": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "state": {
          "$ref": "#/$defs/TransitionReviewState"
        },
        "transition": {
          "$ref": "#/$defs/Transition"
        },
        "updated_at_unix_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "review_id",
        "transition",
        "state",
        "revision",
        "created_at_unix_ms",
        "updated_at_unix_ms"
      ],
      "type": "object"
    },
    "TransitionReviewState": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/TransitionReviewResource"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "required": [
    "schema",
    "reviews"
  ],
  "title": "TransitionReviewPage",
  "type": "object"
}
