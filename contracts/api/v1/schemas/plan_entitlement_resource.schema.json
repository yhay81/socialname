{
  "$defs": {
    "PlanCapability": {
      "enum": [
        "managed_search",
        "monitoring"
      ],
      "type": "string"
    },
    "PlanCode": {
      "enum": [
        "community",
        "developer",
        "monitor",
        "evaluation"
      ],
      "type": "string"
    },
    "PlanEntitlementState": {
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "type": "string"
    },
    "ProtocolVersion": {
      "enum": [
        "socialname.dev/api/v1"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_until_unix_ms": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/PlanCapability"
      },
      "type": "array"
    },
    "effective_at_unix_ms": {
      "format": "int64",
      "type": "integer"
    },
    "evaluated_at_unix_ms": {
      "format": "int64",
      "type": "integer"
    },
    "plan": {
      "$ref": "#/$defs/PlanCode"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "$ref": "#/$defs/ProtocolVersion"
    },
    "state": {
      "$ref": "#/$defs/PlanEntitlementState"
    },
    "updated_at_unix_ms": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "plan",
    "state",
    "capabilities",
    "revision",
    "effective_at_unix_ms",
    "updated_at_unix_ms",
    "evaluated_at_unix_ms"
  ],
  "title": "PlanEntitlementResource",
  "type": "object"
}
