{
  // Static-asset-only Worker for the SocialName product page. There is no
  // `main` script: every request is answered from the committed files in this
  // directory, so the deployed site runs no code and holds no state.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialname-site",
  "compatibility_date": "2026-07-28",
  "assets": {
    // Only `public/` is uploaded, so this configuration file is never served.
    "directory": "./public",
    // Unknown paths return the committed 404 page rather than silently
    // serving the landing page with a 200.
    "not_found_handling": "404-page"
  },
  // socialname.net is the product domain (decision 2026-07-29) and
  // socialname.yhay81.com stays attached so existing links keep resolving.
  // Both are already-provisioned custom domains, managed in the dashboard
  // rather than declared here, matching deploy/api. Declaring them made every
  // deployment call the zone routes API, which a least-privilege deployment
  // token cannot do; omitting them lets the token publish page content
  // without also being able to repoint the zone.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
