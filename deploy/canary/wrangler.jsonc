{
  // Regional canary runner. One deployment per managed region, because the
  // vantage a report declares is only meaningful if the process actually ran
  // there. Acceptance needs three regions with three runs each spanning at
  // least 18 hours inside one exact 24-hour window. The cron fires every two
  // hours so several best-effort trigger misses can occur without making the
  // evidence window impossible.
  //
  // Cloudflare's cron proved unreliable enough that one region produced
  // nothing for a full day, so an external scheduler can also start a run
  // over HTTP. That path is guarded by a shared secret compared in constant
  // time, and refuses everything when no secret is configured.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialname-canary-enam",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  // The trigger endpoint needs a reachable origin. Authorization, not
  // unreachability, is what keeps a request from starting a probe.
  "workers_dev": true,
  // Preview URLs would be additional reachable origins nobody asked for.
  "preview_urls": false,
  "containers": [
    {
      "class_name": "CanaryRunnerContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "lite",
      "max_instances": 1,
      "constraints": {
        "regions": ["ENAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CANARY_RUNNER",
        "class_name": "CanaryRunnerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanaryRunnerContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "socialname-canary-reports"
    }
  ],
  "triggers": {
    "crons": ["0 */2 * * *"]
  },
  "vars": {
    "CANARY_REGION": "enam",
    "CANARY_SITES": "github,gitlab,mastodon-social"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "wnam": {
      "name": "socialname-canary-wnam",
      "workers_dev": true,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "CanaryRunnerContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "lite",
          "max_instances": 1,
          "constraints": {
            "regions": ["WNAM"]
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CANARY_RUNNER",
            "class_name": "CanaryRunnerContainer"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "REPORTS",
          "bucket_name": "socialname-canary-reports"
        }
      ],
      "triggers": {
        "crons": ["20 */2 * * *"]
      },
      "vars": {
        "CANARY_REGION": "wnam",
        "CANARY_SITES": "github,gitlab,mastodon-social"
      }
    },
    "weur": {
      "name": "socialname-canary-weur",
      "workers_dev": true,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "CanaryRunnerContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "lite",
          "max_instances": 1,
          "constraints": {
            "regions": ["WEUR"]
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CANARY_RUNNER",
            "class_name": "CanaryRunnerContainer"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "REPORTS",
          "bucket_name": "socialname-canary-reports"
        }
      ],
      "triggers": {
        "crons": ["40 */2 * * *"]
      },
      "vars": {
        "CANARY_REGION": "weur",
        "CANARY_SITES": "github,gitlab,mastodon-social"
      }
    }
  }
}
