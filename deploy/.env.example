# Copy to deploy/.env and replace both values. Never commit the result.
#
# Generate each secret with an independent CSPRNG, for example
#   POSTGRES_PASSWORD:
#     openssl rand -base64 32
#   SOCIALNAME_SUPPRESSION_HMAC_KEY_HEX (exactly 64 lowercase hex characters):
#     openssl rand -hex 32
#
# The suppression key is persistent: deletion suppression tokens are HMACs
# under it, and an active token from a different key fails closed rather than
# silently forgetting an erasure. Losing it means losing the ability to honour
# prior deletion requests, so back it up with the same care as the database.

POSTGRES_PASSWORD=replace-me
SOCIALNAME_SUPPRESSION_HMAC_KEY_HEX=replace-with-64-lowercase-hex-characters
